# Browser-safe operator link only. Never put an n8n API key in a VITE_* variable.
VITE_N8N_CONSOLE_URL=https://n8n.example.com

# Vercel server-side control gateway configuration.
TAYOCA_CONTROL_GATEWAY_URL=https://n8n.example.com/webhook/tayoca-control/v6
TAYOCA_CONTROL_GATEWAY_TOKEN=replace-with-server-only-secret

# Production access is fail-closed unless all four controls are configured.
CONTROL_CENTER_CANONICAL_HOST=control.example.com
CLOUDFLARE_ACCESS_AUD=replace-with-cloudflare-access-application-audience
CLOUDFLARE_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com

# Keep false for the protected preview deployment.
ALLOW_PRODUCTION_CONTROL_CENTER=false

# Optional: configure Supabase only if a separate application-level login is desired.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
